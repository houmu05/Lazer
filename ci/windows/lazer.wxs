<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 authoring for the Windows MSI. `ci/package-windows-msi.ps1` runs
  heat.exe over the Flutter release bundle to fill the AppFiles component
  group and passes the variables below; nothing here harvests by hand.

  Variables: ReleaseDir, ProductVersion (numeric x.y.z), DisplayName, AppIcon.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="$(var.DisplayName)"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="houmu05"
      Codepage="65001"
      UpgradeCode="6D2C0B5E-4B6A-4C39-9A4E-5A6B2F1D3C7E">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Lazer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Lazer" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Lazer" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut
            Id="AppShortcut"
            Name="Lazer"
            Description="Lazer - Field Player"
            Target="[INSTALLFOLDER]lazer_nextgen.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\houmu05\Lazer"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Lazer" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>
</Wix>
